Host github.com
  HostName github.com
  User git
  IdentityFile ~/.ssh/id_rsa
  UseKeychain yes
  AddKeysToAgent yes

# Ejemplo servidor de trabajo
# Host mi-servidor
#   HostName 192.168.1.100
#   User deploy
#   IdentityFile ~/.ssh/id_rsa
#   Port 22

# Include para hosts locales no versionados
Include ~/.ssh/config.local
